<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.theinformationlab.extensions.imageviewer" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Teste</description>
    <author name="Elizeu Fachini" email="elizeu.fachini@everymind.uol" organization="Everymind by Air Group" website="https://airgroup.ai"/>
    <min-api-version>0.1</min-api-version>
    <source-location>
      <url>https://elizeuelieber.github.io/assai-tableau-s3-extension/index.html</url>
    </source-location>
    <icon></icon>
    <context-menu>
      <configure-context-menu-item />
	  <configuration>
		  <url>https://elizeuelieber.github.io/assai-tableau-s3-extension/config.html</url>
		</configuration>

    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Image Viewer</text>
    </resource>
  </resources>
</manifest>